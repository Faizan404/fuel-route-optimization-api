                  "pm.test('start is rejected as outside the USA', () => {",
                  "  pm.expect(error.code).to.eql('location_not_resolved');",
                  "  pm.expect(error.field).to.eql('start');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
