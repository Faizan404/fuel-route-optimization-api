{
  "info": {
    "name": "Fuel Route Optimization API",
    "description": "Driving route between two US locations with cost-optimal fuel stops (500-mile range, 10 MPG). Set the base_url collection variable to where the Django server runs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Route plan",
      "item": [
        {
          "name": "Long route with fuel stops (Chicago to Miami)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/route/?start=Chicago, IL&finish=Miami, FL",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "route",
                ""
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Chicago, IL"
                },
                {
                  "key": "finish",
                  "value": "Miami, FL"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns route distance and map geometry', () => {",
                  "  pm.expect(body.route.distance_miles).to.be.above(1200).and.below(1500);",
                  "  pm.expect(body.route.geometry.type).to.eql('LineString');",
                  "  pm.expect(body.route.geometry.coordinates.length).to.be.above(100);",
                  "  pm.expect(body.map_url).to.include('/api/v1/route/map/');",
                  "});",
                  "pm.test('has fuel stops with prices', () => {",
                  "  pm.expect(body.fuel_stops.length).to.be.at.least(2);",
                  "  body.fuel_stops.forEach(s => {",
                  "    pm.expect(s.price_per_gallon).to.be.above(0);",
                  "    pm.expect(s.name).to.be.a('string').and.not.empty;",
                  "  });",
                  "});",
                  "pm.test('no leg exceeds the 500-mile range', () => {",
                  "  const marks = [0].concat(body.fuel_stops.map(s => s.mile_marker), [body.route.distance_miles]);",
                  "  for (let i = 1; i < marks.length; i++) pm.expect(marks[i] - marks[i - 1]).to.be.at.most(500);",
                  "});",
                  "pm.test('fuel consumed is distance / 10 MPG', () => {",
                  "  pm.expect(body.summary.fuel_consumed_gallons).to.be.closeTo(body.route.distance_miles / 10, 0.05);",
                  "});",
                  "pm.test('total cost is the sum of the stops', () => {",
                  "  const sum = body.fuel_stops.reduce((t, s) => t + s.cost, 0);",
                  "  pm.expect(body.summary.total_fuel_cost).to.be.closeTo(sum, 0.02);",
                  "  body.fuel_stops.forEach(s => pm.expect(s.cost).to.be.closeTo(s.gallons_purchased * s.price_per_gallon, 0.02));",
                  "});",
                  "pm.test('lists the stations weighed and explains each stop', () => {",
                  "  const miles = body.stations_on_route.map(s => s.mile_marker);",
                  "  pm.expect(miles).to.eql([...miles].sort((a, b) => a - b));",
                  "  const ids = new Set(body.stations_on_route.map(s => s.station_id));",
                  "  body.fuel_stops.forEach((s, i) => {",
                  "    pm.expect(ids.has(s.station_id)).to.be.true;",
                  "    pm.expect(s.decision.action).to.be.oneOf(['fill_up', 'just_enough', 'finish']);",
                  "    pm.expect(s.decision.action === 'finish').to.eql(i === body.fuel_stops.length - 1);",
                  "  });",
                  "});",
                  "pm.test('keeps the reserve and the minimum purchase at every stop', () => {",
                  "  body.fuel_stops.forEach(s => {",
                  "    pm.expect(s.fuel_on_arrival_gallons).to.be.at.least(body.vehicle.reserve_gallons - 0.01);",
                  "    pm.expect(s.gallons_purchased).to.be.at.least(body.summary.min_purchase_gallons - 0.01);",
                  "  });",
                  "  pm.expect(body.summary.total_cost_including_stop_cost).to.be.closeTo(body.summary.total_fuel_cost + body.summary.stop_cost_usd * body.summary.number_of_stops, 0.02);",
                  "});",
                  "pm.test('stop costs are exact receipts and the total is their sum', () => {",
                  "  body.fuel_stops.forEach(s => pm.expect(s.cost).to.eql(Math.round(s.gallons_purchased * s.price_per_gallon * 100) / 100));",
                  "  const sum = Math.round(body.fuel_stops.reduce((t, s) => t + s.cost, 0) * 100) / 100;",
                  "  pm.expect(body.summary.total_fuel_cost).to.eql(sum);",
                  "});",
                  "pm.test('trip fuel cost prices the starting tank at the first stop', () => {",
                  "  const s = body.summary, fromStart = s.fuel_consumed_gallons - s.fuel_purchased_gallons;",
                  "  pm.expect(s.trip_fuel_cost).to.be.closeTo(fromStart * body.fuel_stops[0].price_per_gallon + s.total_fuel_cost, 0.02);",
                  "});"
                ]
              }
            }
          ]
        },
